<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ghosthands.app"
    android:versionCode="38"
    android:versionName="3.16.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v3.0 (item 3): voice goals. The only permission this
         release adds; requested at runtime the first time the
         mic is tapped, and used only by the framework speech
         recognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="false">
        <!-- v3.0: singleTop so a check/finish notification tap
             reaches the live instance via onNewIntent instead of
             stacking a second Activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- v3.0 (item 2): the scheduled-check alarm receiver.
             Not exported: only this app's own alarms (and the
             system delivering them) can reach it. -->
        <receiver
            android:name=".CheckReceiver"
            android:exported="false" />
        <!-- v3.14 (Everything Train R6 — the accessibility
             spike): the spike's AccessibilityService. NEW
             SURFACE, called out plainly: this declares a
             service the user may enable in Android Settings;
             it adds NO uses-permission (the four above are
             the whole set, unchanged) and the service is
             inert unless the user enables it there AND the
             experimental toggle in Settings > DIAGNOSTICS is
             on (SpikeGate). The BIND_ACCESSIBILITY_SERVICE
             permission below is the service's own protection
             (only the system may bind it), not an app
             permission. -->
        <service
            android:name=".GhostA11yService"
            android:label="@string/app_name"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_service_config" />
        </service>
        <!-- v3.16 (Everything Train R8 — governed downloads):
             the downloads store's content provider. NEW
             SURFACE, called out plainly like the service
             above: it exists so a stored file can be opened
             in a system viewer or shared (a file:// URI is
             refused at this target SDK). It serves ONLY the
             app's private downloads directory, read-only, is
             not exported, and answers only through per-URI
             read grants the app hands out itself. It adds NO
             uses-permission — the four above are still the
             whole set. -->
        <provider
            android:name=".DlProvider"
            android:authorities="com.ghosthands.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
